# Integrated Geospatial and Environmental Observation Infrastructure
# University of West Florida — editable proposal figure
#
library(ggplot2)
# Arial keeps the figure consistent with the proposal. Arial Unicode MS is used
# only for the line containing the double-headed-arrow symbols.
font_family <- "Arial"
symbol_font_family <- "Arial Unicode MS"
# -----------------------------------------------------------------------------
# 1. EDITABLE TEXT
# -----------------------------------------------------------------------------
department_titles <- c(
biology = "Biology",
earth = "Earth & Environmental Sciences",
archaeology = "Anthropology & Archaeology"
)
department_details <- c(
biology = "Ecology • Habitats •\nOrganism–environment Relationships",
earth = "Geomorphology • Hydrodynamics •\nClimate Science • Geospatial Science",
archaeology = "Cultural Landscapes •\nTerrestrial & Maritime Resources"
)
application_titles <- c(
geomorph = "Coastal Geomorphology &\nLandscape Dynamics",
ecology = "Terrestrial Ecology &\nEcogeomorphology",
marine = "Estuarine &\nMarine Ecology",
archaeology = "Terrestrial Archaeology &\nCultural Landscapes",
maritime = "Maritime Archaeology &\nSubmerged Landscapes"
)
application_details <- c(
geomorph = "Morphologic Change •\nSediment Dynamics •\nSystem Response & Recovery",
ecology = "Vegetation Structure •\nOrganism–landform Feedbacks •\nDisturbance & Succession",
marine = "Water Quality • Hydrodynamics •\nBenthic & Submerged Habitats •\nHydroecological Response",
archaeology = "Site Documentation •\nLandscape Context •\nConservation & Preservation",
maritime = "Detection & Documentation •\nBurial & Exposure •\nHeritage Site Stewardship"
)
top_connector_label <-
""
core_title <- "Connected Natural & Cultural Systems Research"
core_lines <- c(
"Environmental Forcing \u2194 Spatial Response \u2194 Ecological Change \u2194 Cultural-resource Condition",
"Discipline-centered Investigations  •  Cross-disciplinary Projects  •  Coordinated Field Campaigns",
"Repeat Observation  •  Rapid Response  •  Multiscale Interpretation"
)
# -----------------------------------------------------------------------------
# 2. EDITABLE COLORS
# -----------------------------------------------------------------------------
colors <- list(
page_background = "#FFFFFF",
department_fill = "#F4EFE4",
department_border = "#A58C58",
application_fill = "#E8F1F5",
application_border = "#4E7D91",
core_fill = "#173F5F",
core_border = "#173F5F",
core_text = "#FFFFFF",
primary_text = "#18384D",
secondary_text = "#5B6570",
connector = "#7A858C"
)
# -----------------------------------------------------------------------------
# 3. EDITABLE GEOMETRY
# Coordinates use a 0–100 horizontal scale and a 0–70 vertical scale.
# -----------------------------------------------------------------------------
departments <- data.frame(
id = c("biology", "earth", "archaeology"),
xmin = c(4, 36.5, 69),
xmax = c(31, 63.5, 96),
ymin = c(53, 53, 53),
ymax = c(62, 62, 62),
stringsAsFactors = FALSE
)
departments$title <- unname(department_titles[departments$id])
departments$details <- unname(department_details[departments$id])
# Five equal-width application boxes.
applications <- data.frame(
id = c("geomorph", "ecology", "marine", "archaeology", "maritime"),
xmin = c(1, 21, 41, 61, 81),
xmax = c(19, 39, 59, 79, 99),
ymin = c(28.5, 28.5, 28.5, 28.5, 28.5),
ymax = c(40.5, 40.5, 40.5, 40.5, 40.5),
stringsAsFactors = FALSE
)
applications$title <- unname(application_titles[applications$id])
applications$details <- unname(application_details[applications$id])
core <- data.frame(
xmin = 16,
xmax = 84,
ymin = 3.75,
ymax = 17.25
)
top_bus_y <- 47.5
bottom_bus_y <- 22.5
row_titles <- data.frame(
x = c(50, 50, 50),
y = c(64.75, 43, 19.25),
label = c(
"SHARED DISCIPLINARY CONTRIBUTIONS",
"REPRESENTATIVE SCIENTIFIC APPLICATIONS",
"INTEGRATED INTERPRETATION"
)
)
# -----------------------------------------------------------------------------
# 4. HELPER FUNCTIONS
# -----------------------------------------------------------------------------
box_center_x <- function(data) (data$xmin + data$xmax) / 2
add_box_layer <- function(
plot,
data,
fill,
border,
label_color,
title_size,
detail_size,
title_from_top,
details_from_bottom,
detail_line_spacing = 1.08
) {
plot +
geom_rect(
data = data,
aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax),
inherit.aes = FALSE,
fill = fill,
color = border,
linewidth = 0.65
) +
geom_text(
data = data,
aes(
x = (xmin + xmax) / 2,
y = ymax - title_from_top,
label = title
),
inherit.aes = FALSE,
color = label_color,
size = title_size,
lineheight = 1.0,
fontface = "bold",
family = font_family
) +
geom_text(
data = data,
aes(
x = (xmin + xmax) / 2,
y = ymin + details_from_bottom,
label = details
),
inherit.aes = FALSE,
color = label_color,
size = detail_size,
lineheight = detail_line_spacing,
family = font_family
)
}
# -----------------------------------------------------------------------------
# 5. BUILD THE FIGURE
# -----------------------------------------------------------------------------
application_centers <- box_center_x(applications)
p <- ggplot() +
# Departments connect to a shared expertise bus.
geom_segment(
data = departments,
aes(
x = (xmin + xmax) / 2,
xend = (xmin + xmax) / 2,
y = ymin,
yend = top_bus_y
),
inherit.aes = FALSE,
color = colors$connector,
linewidth = 0.6
) +
annotate(
"segment",
x = min(box_center_x(departments)),
xend = max(box_center_x(departments)),
y = top_bus_y,
yend = top_bus_y,
color = colors$connector,
linewidth = 0.85
) +
annotate(
"text",
x = 50,
y = top_bus_y + 1.15,
label = top_connector_label,
color = colors$secondary_text,
size = 2.8,
family = font_family
) +
# The shared bus distributes expertise to all five research applications.
annotate(
"segment",
x = min(application_centers),
xend = max(application_centers),
y = top_bus_y,
yend = top_bus_y,
color = colors$connector,
linewidth = 0.85
) +
geom_segment(
data = applications,
aes(
x = (xmin + xmax) / 2,
xend = (xmin + xmax) / 2,
y = top_bus_y,
yend = ymax
),
inherit.aes = FALSE,
color = colors$connector,
linewidth = 0.6
) +
# The five application areas converge on integrated interpretation.
geom_segment(
data = applications,
aes(
x = (xmin + xmax) / 2,
xend = (xmin + xmax) / 2,
y = ymin,
yend = bottom_bus_y
),
inherit.aes = FALSE,
color = colors$connector,
linewidth = 0.6
) +
annotate(
"segment",
x = min(application_centers),
xend = max(application_centers),
y = bottom_bus_y,
yend = bottom_bus_y,
color = colors$connector,
linewidth = 0.85
) +
annotate(
"segment",
x = 50,
xend = 50,
y = bottom_bus_y,
yend = core$ymax,
color = colors$connector,
linewidth = 0.85
)
p <- add_box_layer(
p,
departments,
colors$department_fill,
colors$department_border,
colors$primary_text,
title_size = 3.55,
detail_size = 3.05,
title_from_top = 3.0,
details_from_bottom = 3.5
)
p <- add_box_layer(
p,
applications,
colors$application_fill,
colors$application_border,
colors$primary_text,
title_size = 3.15,
detail_size = 2.70,
title_from_top = 3.5,
details_from_bottom = 4.2,
detail_line_spacing = 1.05
)
# Add the integrated research outcome.
p <- p +
geom_rect(
data = core,
aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax),
inherit.aes = FALSE,
fill = colors$core_fill,
color = colors$core_border,
linewidth = 0.9
) +
annotate(
"text",
x = 50,
y = 14.6,
label = core_title,
color = colors$core_text,
size = 4,
fontface = "bold",
family = font_family
) +
annotate(
"text",
x = 50,
y = 10.7,
label = core_lines[1],
color = colors$core_text,
size = 2.9,
family = symbol_font_family
) +
annotate(
"text",
x = 50,
y = 7.2,
label = paste(core_lines[2:3], collapse = "\n"),
color = colors$core_text,
size = 3.05,
lineheight = 1.35,
family = font_family
) +
geom_text(
data = row_titles,
aes(x = x, y = y, label = label),
inherit.aes = FALSE,
color = colors$secondary_text,
size = 3.8,
fontface = "bold",
family = font_family
) +
coord_cartesian(
xlim = c(0, 100),
ylim = c(0, 70),
expand = FALSE,
clip = "off"
) +
theme_void(base_family = font_family) +
theme(
plot.background = element_rect(fill = colors$page_background, color = NA),
plot.margin = margin(14, 14, 14, 14)
)
if (interactive()) print(p)
# -----------------------------------------------------------------------------
# 6. EXPORT
# -----------------------------------------------------------------------------
# Determine the script's directory when sourced through RStudio or Rscript.
get_script_directory <- function() {
command_args <- commandArgs(trailingOnly = FALSE)
file_arg <- grep("^--file=", command_args, value = TRUE)
if (length(file_arg) > 0) {
return(dirname(normalizePath(sub("^--file=", "", file_arg[1]))))
}
if (requireNamespace("rstudioapi", quietly = TRUE) &&
rstudioapi::isAvailable()) {
active_path <- rstudioapi::getActiveDocumentContext()$path
if (nzchar(active_path)) {
return(dirname(normalizePath(active_path)))
}
}
return(getwd())
}
output_directory <- get_script_directory()
file_stem <- file.path(
output_directory,
"integrated_observation_framework"
)
ggsave(
filename = paste0(file_stem, ".png"),
plot = p,
width = 13,
height = 9,
units = "in",
dpi = 300,
bg = colors$page_background
)
ggsave(
filename = paste0(file_stem, ".pdf"),
plot = p,
width = 13,
height = 9,
units = "in",
device = cairo_pdf,
bg = colors$page_background
)
if (requireNamespace("svglite", quietly = TRUE)) {
ggsave(
filename = paste0(file_stem, ".svg"),
plot = p,
width = 13,
height = 9,
units = "in",
device = svglite::svglite,
bg = colors$page_background
)
} else {
message(
"SVG was not created. Install the optional 'svglite' package ",
"if editable SVG output is desired."
)
}
message("Figure files saved in: ", output_directory)
